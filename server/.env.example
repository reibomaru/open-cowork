# ── pi-coding-agent / モデル設定 ──
# pi-coding-agent はマルチプロバイダ対応。anthropic API key を直接使う設定が既定。

# 既定プロバイダ
MODEL_PROVIDER=anthropic

# anthropic 直叩き用 API key
# ANTHROPIC_API_KEY=sk-ant-...

# pi-coding-agent の設定ディレクトリ (settings.json / auth.json / models.json / sessions/ の置き場所)。
# 未設定なら ~/.pi/agent を使用する。
# PI_AGENT_DIR=/var/data/pi-agent

# ── モデル設定 ──
# メインチャットの 3 モデル (Opus/Sonnet/Haiku) の provider/model は server/src/models.ts に
# 既定値があり、必要に応じて以下の env で上書きできる。
# CLAUDE_MODEL_OPUS=claude-opus-4-5
# CLAUDE_MODEL_SONNET=claude-sonnet-4-5
# CLAUDE_MODEL_HAIKU=claude-haiku-4-5

# セッション作成時のデフォルトモデル表示名
DEFAULT_MODEL=claude-sonnet-4-6

# タイトル要約 / artifact タイトル用の Haiku 設定
TITLE_GEN_PROVIDER=anthropic
TITLE_GEN_MODEL=claude-haiku-4-5
ARTIFACT_TITLE_PROVIDER=anthropic
ARTIFACT_TITLE_MODEL=claude-haiku-4-5

# ── 認証 ──
# 開発用の固定 userId。X-User-Id ヘッダが付かないときのフォールバック。
# NODE_ENV=production では無効化される。
DEV_USER_ID=dev-user-1

# CORS 許可オリジン (カンマ区切り)。Vite dev server: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ── サーバ設定 ──
PORT=3000

# ── DynamoDB Sessions テーブル ──
# docker-compose の dynamodb-local + dynamodb-init が同名テーブルを自動作成する。
DYNAMODB_TABLE_SESSIONS=sessions-local
